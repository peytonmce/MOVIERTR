{
  "name": "moviertr",
  "version": "1.0.0",
  "description": "A dockerized full stack movie rating app that uses a NodeJS backend, a PostgreSQL database, a Prisma ORM, and JWT Authentication",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --watch --env-file=.env --experimental-strip-types --experimental-sqlite ./src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma generate",
    "build": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}